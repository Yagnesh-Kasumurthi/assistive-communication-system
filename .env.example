# Assistive Communication System — Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════

# In Development (leave empty to auto-detect localhost:5000/5001):
# VITE_API_URL=http://localhost:5000

# In Production (Set to your deployed backend URL on Render/Railway):
VITE_API_URL=https://your-backend-service.onrender.com
