# ═══════════════════════════════════════════════════════════════
# Assistive Communication System — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════

# Port for Express server (automatically assigned by Render/Railway in production)
PORT=5000

# Allowed CORS Origin (default: * for all origins)
CORS_ORIGIN=*

# Node Environment (development | production)
NODE_ENV=production
